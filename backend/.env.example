PORT=5000

# MySQL / Aiven connection
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=weconnect

# Optional: path to the SSL CA bundle (used for Aiven). Leave blank to use certs/ca.pem
DB_SSL_CA=

# Secret used to sign JWT tokens
JWT_SECRET=change-me

# Allowed frontend origin for CORS (only needed when running the Vite dev server)
FRONTEND_URL=http://localhost:5173